{
  "identifier": "com.boltai.popclip.workflow",
  "name": "BoltAI Workflows",
  "description": "Run a BoltAI workflow on selected text.",
  "popclipVersion": 6221,
  "icon": "symbol:bolt.fill",
  "app": {
    "name": "BoltAI",
    "link": "https://boltai.com",
    "checkInstalled": true,
    "bundleIdentifiers": [
      "co.podzim.boltai-mobile",
      "co.podzim.boltai-mobile-setapp"
    ]
  },
  "javaScript": "await popclip.openUrl('bolt://workflow?text=' + encodeURIComponent(popclip.input.text), {activate: false, ...(popclip.options.targetApp === 'automatic' ? {} : {app: popclip.options.targetApp})});",
  "keywords": "AI workflow rewrite summarize selected text",
  "options": [
    {
      "identifier": "targetApp",
      "type": "multiple",
      "label": "Open with",
      "description": "Choose which BoltAI app to use when both editions are installed.",
      "values": [
        "automatic",
        "co.podzim.boltai-mobile",
        "co.podzim.boltai-mobile-setapp"
      ],
      "valueLabels": [
        "macOS default",
        "BoltAI (website)",
        "BoltAI (Setapp)"
      ],
      "defaultValue": "automatic"
    }
  ]
}
